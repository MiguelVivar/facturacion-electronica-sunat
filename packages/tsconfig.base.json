{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@miguelvivar/sunat-fe-core": ["../core/src/index.ts"],
      "@miguelvivar/sunat-fe-xml": ["../xml/src/index.ts"],
      "@miguelvivar/sunat-fe-signer": ["../signer/src/index.ts"],
      "@miguelvivar/sunat-fe-client": ["../client/src/index.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
