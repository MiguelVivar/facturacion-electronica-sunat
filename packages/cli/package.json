{
  "name": "sunat-fe",
  "version": "0.1.0",
  "description": "CLI para facturación electrónica SUNAT (Perú): catálogos, cálculo de montos/IGV, generación de XML UBL 2.1, firma XML-DSig y envío SOAP a SUNAT (firma aún no validada por SUNAT — ver PRODUCT.md).",
  "type": "module",
  "bin": {
    "sunat-fe": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "bun test"
  },
  "dependencies": {
    "sunat-fe-core": "workspace:*",
    "sunat-fe-xml": "workspace:*",
    "sunat-fe-signer": "workspace:*",
    "sunat-fe-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0"
  },
  "license": "MIT",
  "keywords": ["sunat", "facturacion-electronica", "peru", "ubl", "cli"]
}
