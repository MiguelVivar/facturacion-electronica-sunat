{
  "name": "@miguelvivar/sunat-fe",
  "version": "0.1.0",
  "description": "CLI para facturación electrónica SUNAT (Perú): catálogos, cálculo de montos/IGV, generación de XML UBL 2.1, firma XML-DSig y envío SOAP a SUNAT.",
  "type": "module",
  "bin": {
    "sunat-fe": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguelVivar/facturacion-electronica-sunat.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test"
  },
  "dependencies": {
    "@miguelvivar/sunat-fe-core": "workspace:*",
    "@miguelvivar/sunat-fe-xml": "workspace:*",
    "@miguelvivar/sunat-fe-signer": "workspace:*",
    "@miguelvivar/sunat-fe-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0"
  },
  "license": "MIT",
  "keywords": [
    "sunat",
    "facturacion-electronica",
    "peru",
    "ubl",
    "cli"
  ]
}
