---
interface Props {
  title: string;
  description: string;
  activo?: 'inicio' | 'cli' | 'catalogos' | 'arquitectura';
}
const { title, description, activo = 'inicio' } = Astro.props;

const enlaces = [
  { href: '/', clave: 'inicio', etiqueta: 'Inicio' },
  { href: '/cli/', clave: 'cli', etiqueta: 'CLI' },
  { href: '/catalogos/', clave: 'catalogos', etiqueta: 'Catálogos' },
  { href: '/arquitectura/', clave: 'arquitectura', etiqueta: 'Arquitectura' },
] as const;
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>

  <div class="sticky top-0 z-20 flex items-center gap-4 bg-terminal-black text-console-cream px-5 py-3.5 font-mono text-[0.8rem] tracking-wide border-b border-terminal-rule">
    <a href="/" class="flex items-center gap-3 no-underline shrink-0 text-console-cream hover:opacity-90">
      <img src="/favicon.svg" alt="SUNAT FE Logo" class="w-6 h-6 shrink-0" />
      <span class="text-aged-rule/90 whitespace-nowrap overflow-hidden text-ellipsis hover:text-console-cream font-mono">~/.claude/skills/sunat-facturacion-electronica</span>
    </a>
    <nav class="ml-auto hidden md:flex gap-5">
      {enlaces.map((e) => (
        <a
          class:list={[
            'no-underline uppercase text-[0.72rem] tracking-wider hover:opacity-100 hover:border-b hover:border-stamp-red',
            activo === e.clave ? 'opacity-100 border-b border-stamp-red' : 'opacity-75',
          ]}
          href={e.href}
        >{e.etiqueta}</a>
      ))}
    </nav>
    <details class="titlebar-menu md:hidden ml-auto relative">
      <summary class="text-[0.72rem] uppercase tracking-wider">Menú</summary>
      <nav class="absolute top-[calc(100%+0.6rem)] right-0 flex flex-col gap-0 bg-terminal-black border border-terminal-rule py-1.5 min-w-[180px]">
        {enlaces.map((e) => (
          <a class="no-underline px-4 py-2 opacity-85 hover:bg-terminal-rule" href={e.href}>{e.etiqueta}</a>
        ))}
      </nav>
    </details>
  </div>

  <main>
    <slot />
  </main>

  <footer class="bg-terminal-black text-console-cream px-6 pt-12 pb-10 text-center font-mono text-[0.8rem]">
    <div class="flex justify-center mb-6">
      <img src="/logo.svg" alt="Facturación Electrónica SUNAT Logo" class="h-10 w-auto opacity-90" />
    </div>
    <p class="text-aged-rule max-w-[50ch] mx-auto mb-4 leading-relaxed">sunat-facturacion-electronica: un skill que sabe que un comprobante mal emitido tiene consecuencias tributarias reales, no solo un bug que revertir.</p>
    <hr class="border-0 border-t border-dashed border-terminal-rule my-6 max-w-[320px] mx-auto" />
    <p>$ echo "comprobante generado · ledger cerrado"</p>
  </footer>

  <script>
    // Reveal-on-scroll for stamps and section heads; skipped entirely under reduced motion.
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('.reveal');
    if (!prefersReduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.35 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }

    // Copy-to-clipboard for console code blocks.
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-copy-target');
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        navigator.clipboard.writeText(target.innerText).then(() => {
          btn.setAttribute('data-copied', 'true');
          setTimeout(() => btn.removeAttribute('data-copied'), 1800);
        });
      });
    });
  </script>

</body>
</html>
